[Unit]
Description=Dune map watchdog
After=docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/home/keith/Documents/code/DuneAwakeningSelfHost
Environment=DUNE_WATCH_INTERVAL=30
Environment=DUNE_WATCH_RECOVERY_WAIT=360
Environment=DUNE_WATCH_COOLDOWN=300
Environment=DUNE_WATCH_STARTUP_GRACE=300
Environment=DUNE_WATCH_LOCK_DIR=/tmp/dune-map-watchdog.lock
Environment=DUNE_WATCH_SEED_NEIGHBORS=true
Environment=DUNE_WATCH_SEED_INTERVAL=300
Environment=DUNE_WATCH_SEED_TIMEOUT=90
Environment=DUNE_WATCH_CONTROL_PLANE_ENABLED=true
Environment=DUNE_WATCH_CONTROL_PLANE_INTERVAL=30
Environment=DUNE_WATCH_CONTROL_PLANE_REPAIR_ENABLED=true
Environment=DUNE_WATCH_CONTROL_PLANE_REPAIR_INTERVAL=300
Environment=DUNE_WATCH_DEGRADED_CONFIRMATIONS=2
Environment=DUNE_WATCH_REQUIRED_READY_PARTITIONS=1,2
Environment=DOCKER_CONFIG=/home/keith/.docker
ExecStart=/home/keith/Documents/code/DuneAwakeningSelfHost/scripts/watch-maps.sh /home/keith/Documents/code/DuneAwakeningSelfHost/.env
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
