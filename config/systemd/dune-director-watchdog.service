[Unit]
Description=Dune Director login-crash watchdog
After=docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/home/keith/Documents/code/DuneAwakeningSelfHost
Environment=DUNE_DIRECTOR_WATCHDOG_INTERVAL=15
Environment=DUNE_DIRECTOR_WATCHDOG_PUBLICATION_ENABLED=true
Environment=DUNE_DIRECTOR_WATCHDOG_PUBLICATION_INTERVAL=60
Environment=DUNE_DIRECTOR_WATCHDOG_PUBLICATION_FAILURE_THRESHOLD=3
Environment=DUNE_DIRECTOR_WATCHDOG_RECOVERY_COOLDOWN=300
Environment=DUNE_DIRECTOR_WATCHDOG_RECOVERY_TIMEOUT=600
Environment=DUNE_DIRECTOR_WATCHDOG_LOCK_FILE=/tmp/dune-director-watchdog.lock
ExecStart=/home/keith/Documents/code/DuneAwakeningSelfHost/scripts/director-watchdog.sh /home/keith/Documents/code/DuneAwakeningSelfHost/.env
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
